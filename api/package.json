{
    "name": "lps-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "tsx src/db/migrate.ts",
        "seed": "tsx src/db/seed.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fastify/cors": "latest",
        "@fastify/helmet": "latest",
        "@fastify/rate-limit": "latest",
        "fastify-raw-body": "latest",
        "argon2": "latest",
        "dotenv": "latest",
        "fastify": "latest",
        "jsonwebtoken": "latest",
        "pg": "latest",
        "stripe": "latest",
        "zod": "latest"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "latest",
        "@types/node": "latest",
        "@types/pg": "latest",
        "tsx": "latest",
        "typescript": "latest"
    },
    "engines": {
        "node": "^24.21.0"
    }
}